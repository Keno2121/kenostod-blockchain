FALP_ARB_BOT_BOTCHAIN = "0x446b29625fBE8F8Fe254E8fEf7e296224DB4C2d8"
FALP_ARB_BOT_TESTNET = "0x9048733Da99B2d90Ade13fCBfAd3B2d05C47775E"
