modules = ["nodejs-20", "java-graalvm22.3", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = [
  "javascript_database:1.0.0",
  "javascript_openai_ai_integrations:1.0.0",
  "stripe:1.0.0",
]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Kenostod Blockchain Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Kings Shield Website"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Kings Shield Community Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Deploy KENOAutoBurn"

[[workflows.workflow]]
name = "Kenostod Blockchain Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Kings Shield Website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node kings-shield/website/server.js"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Kings Shield Community Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node kings-shield/community-bot.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Deploy KENOAutoBurn"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd keno-bonding && npx hardhat run scripts/deploy-autoburn.js --network bsc"

[workflows.workflow.metadata]
outputType = "console"


[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]

[userenv]

[userenv.shared]
RENDER_SERVICE_ID = "srv-d6q4k1p4tr6s73aev95g"


FAL_ALERT_CHAT_ID = "6715306356"
