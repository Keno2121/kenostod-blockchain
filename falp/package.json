{
  "name": "kenostod-falp",
  "version": "1.1.0",
  "description": "Flash Arbitrage Loan Pool (FALP) — BSC + BOT Chain",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:bsc": "hardhat run scripts/deploy.js --network bsc",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:botchain": "hardhat run scripts/deploy-botchain.js --network botchain",
    "deploy:botchain-testnet": "hardhat run scripts/deploy-botchain-testnet.js --network botchainTestnet",
    "verify:bsc": "hardhat verify --network bsc",
    "test": "hardhat test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "hardhat": "^2.28.6"
  }
}
