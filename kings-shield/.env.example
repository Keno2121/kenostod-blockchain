# ─── King's Shield Bot Environment ─────────────────────────────────────────
# Copy this file to .env and fill in ALL values before running.
# NEVER commit .env to git — it is protected by .gitignore.

# Solana Network: "devnet" for testing, "mainnet-beta" for live
SOLANA_NETWORK=devnet

# RPC endpoint — use Helius/QuickNode on mainnet (free endpoints rate-limit hard)
SOLANA_RPC_DEVNET=https://api.devnet.solana.com
SOLANA_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Bot wallet — generated by wallet_setup/generate_shield_wallet.py
SHIELD_BOT_ADDRESS=YOUR_BOT_WALLET_ADDRESS
SHIELD_BOT_PRIVATE_KEY=YOUR_BOT_WALLET_PRIVATE_KEY_BASE58

# Law VII — Founder's Seal. Run: python wallet_setup/generate_founder_seal.py
# This locks both bots to founder-only control. REQUIRED before mainnet.
FOUNDER_SEAL=YOUR_FOUNDER_SEAL_HASH

# SHIELD token mint address — set AFTER SHIELD deploys on Solana
# Both bots activate SHIELD/SOL arb routes automatically once set
SHIELD_TOKEN_MINT=

# Known token mints (pre-filled)
SOL_MINT=So11111111111111111111111111111111111111112
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# Profit thresholds (Law III — Sovereign Threshold)
MIN_PROFIT_USD=0.25
MIN_PROFIT_SOL=0.002

# Capital guard (Law II — Aegis Covenant)
# Bot will halt if wallet balance drops below this amount in SOL
MIN_WALLET_BALANCE_SOL=0.05

# Flash loan amounts in SOL (Law VI — Kaprekar Constant)
FLASH_AMOUNT_SMALL=0.6174
FLASH_AMOUNT_MEDIUM=1.234
FLASH_AMOUNT_LARGE=6.174

# Scan interval in seconds (Law VI)
SCAN_INTERVAL_SECONDS=61.74

# Log files (Law V — Treasury Mandate)
ARB_PROFIT_LOG=aegis_arb_bot/profit_log.json
FLASH_PROFIT_LOG=constitution_flash_bot/flash_profit_log.json
