# ═══════════════════════════════════════════════════════════════════
#  King's Shield — Bot Environment Variables
#  Copy this to kings-shield/.env and fill in your values.
#  NEVER commit .env to GitHub.
# ═══════════════════════════════════════════════════════════════════

# ── Solana Network ───────────────────────────────────────────────────────
# Use "devnet" for testing, "mainnet-beta" for live trading
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
SOLANA_RPC_DEVNET=https://api.devnet.solana.com

# ── SHIELD Token (filled after deploy) ──────────────────────────────────
# Run: npm run deploy:mainnet  from kings-shield/token22/
# Then run: ts-node post-deploy-sync.ts --cluster mainnet
SHIELD_TOKEN_MINT=                      # filled after mainnet deploy

# ── Bot Wallet (Solana) ──────────────────────────────────────────────────
# Generate with: python wallet_setup/generate_shield_wallet.py
# Then load this wallet with 0.1-0.5 SOL before running bots
SHIELD_BOT_ADDRESS=                     # Solana public key (bot trading wallet)
SHIELD_BOT_PRIVATE_KEY=                 # base58 private key — KEEP SECRET

# ── Founder's Seal (Law VII) ─────────────────────────────────────────────
# Generated by: python wallet_setup/generate_shield_wallet.py
# This is the sha256 hash that locks both Solana bots to founder-only control
FOUNDER_SEAL=                           # 64-char hex — generated once, never changed

# ── Bot Tuning (optional — defaults shown) ───────────────────────────────
MIN_PROFIT_USD=0.25                     # Law III: minimum net profit per trade ($0.25)
MIN_WALLET_BALANCE_SOL=0.05             # Law II: stop trading if SOL balance drops below this
SCAN_INTERVAL_SECONDS=61.74            # Law VI: Kaprekar constant scan interval

# ── Aegis Arb Bot ────────────────────────────────────────────────────────
ARB_PROFIT_LOG=aegis_arb_bot/profit_log.json

# ── Constitution Flash Bot ────────────────────────────────────────────────
FLASH_PROFIT_LOG=constitution_flash_bot/flash_profit_log.json
FLASH_AMOUNT_SMALL=0.6174               # Kaprekar-anchored flash amounts (SOL)
FLASH_AMOUNT_MEDIUM=1.234
FLASH_AMOUNT_LARGE=6.174

# ── Token Mints (hardcoded defaults — only override if needed) ─────────────
SOL_MINT=So11111111111111111111111111111111111111112
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# ── Telegram Alerts (optional) ───────────────────────────────────────────
# TELEGRAM_BOT_TOKEN is already in Replit Secrets
# Get your chat ID: message @userinfobot on Telegram → it replies with your ID
FAL_ALERT_CHAT_ID=                      # e.g. 123456789
