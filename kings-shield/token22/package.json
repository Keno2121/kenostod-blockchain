{
  "name": "kings-shield-token22",
  "version": "1.0.0",
  "description": "King's Shield (SHIELD) — Solana Token-2022 with Aegis Tax + Interest Bearing",
  "scripts": {
    "generate-wallet":     "node generate-wallet.js",
    "deploy:devnet":       "ts-node deploy-shield.ts --cluster devnet",
    "deploy:mainnet":      "ts-node deploy-shield.ts --cluster mainnet",
    "distribute":          "ts-node distribute-allocations.ts",
    "status":              "ts-node check-status.ts --cluster devnet",
    "status:devnet":       "ts-node check-status.ts --cluster devnet",
    "status:mainnet":      "ts-node check-status.ts --cluster mainnet",
    "collect-tax:devnet":  "ts-node collect-aegis-tax.ts --cluster devnet",
    "collect-tax:mainnet": "ts-node collect-aegis-tax.ts --cluster mainnet",
    "revoke:devnet":       "ts-node revoke-mint-authority.ts --cluster devnet --confirm",
    "revoke:mainnet":      "ts-node revoke-mint-authority.ts --cluster mainnet --confirm",
    "revoke:mainnet:full": "ts-node revoke-mint-authority.ts --cluster mainnet --confirm --also-freeze --also-rate",
    "sync:devnet":         "ts-node post-deploy-sync.ts --cluster devnet",
    "sync:mainnet":        "ts-node post-deploy-sync.ts --cluster mainnet",
    "metadata:devnet":     "ts-node setup-metadata.ts --cluster devnet",
    "metadata:mainnet":    "ts-node setup-metadata.ts --cluster mainnet"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0"
  }
}
